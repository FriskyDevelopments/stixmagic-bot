# Stix Magic Bot environment template
# Copy to .env for local DEVELOPMENT testing only.
# Never commit real secrets.

# Runtime mode (required): development | production
APP_ENV=development

# --- Telegram bot token contract ---
# Development: set exactly ONE development token variable.
DEV_BOT_TOKEN=
# TELEGRAM_BOT_TOKEN_DEV=
# BOT_TOKEN_DEV=  # legacy development alias

# Production: set exactly ONE production token variable.
# TELEGRAM_BOT_TOKEN=
# BOT_TOKEN=

# --- API key contract ---
# Required in development:
STIXMAGIC_API_KEY_DEV=

# Required in production (set one):
# STIXMAGIC_API_KEY_PROD=
# STIXMAGIC_API_KEY=

# --- Session secret contract ---
# Optional in development:
SESSION_SECRET_DEV=

# Required in production (set one):
# SESSION_SECRET_PROD=
# SESSION_SECRET=

# --- Mini App URL contract ---
# Optional in development:
MINIAPP_URL_DEV=

# Optional in production (set one):
# MINIAPP_URL_PROD=
# MINIAPP_URL=

# Optional local API port
PORT=5000
