# Stix Magic Bot — environment variable template
# Copy this file to .env for local development and never commit real secrets.

# Telegram bot identity/auth
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# API authentication for privileged /api/* routes
STIXMAGIC_API_KEY=

# Runtime + routing
TELEGRAM_BOT_MODE=polling
STIXMAGIC_DB_PATH=bot.db
STIXMAGIC_MINIAPP_PATH=/miniapp
STIXMAGIC_PUBLIC_BASE_URL=

# Mini App + webhook hardening
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Optional Replit helper:
# REPLIT_DOMAINS=your-app.replit.app
