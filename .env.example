# Stix Magic Bot — environment variable template
# Copy this file to .env and fill in your values for local development.
# Never commit your actual .env file — it is already listed in .gitignore.

# ── Required ─────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Secret key for authenticating REST API requests
STIXMAGIC_API_KEY=your_api_key_here

# ── Optional ─────────────────────────────────────────────────────────────────

# Flask session secret (auto-generated if omitted, but should be set in prod)
SESSION_SECRET=your_flask_session_secret_here

# Telegram Mini App URL (set to enable the Mini App menu button in the bot)
# MINIAPP_URL=https://your-app.example.com/miniapp
