# ─────────────────────────────────────────────────────────────────────────────
# Stix Magic — Environment Variables Reference
#
# This file is a TEMPLATE — copying it to .env does nothing by itself.
# The app does NOT auto-load .env files.  Variables must be present in the
# process environment before the app starts.  Options:
#   • Export in your shell:  export APP_ENV=development
#   • Use a helper:          env $(grep -v '^#' .env | xargs) python main.py
#   • Replit Secrets (recommended for Replit deployments)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime Environment ───────────────────────────────────────────────────────
# Controls which environment the app runs as.
# Values: development | production
# Default: development
APP_ENV=development

# ── Bot Tokens ────────────────────────────────────────────────────────────────
# Production bot token (from @BotFather).
# Used when APP_ENV=production.
TELEGRAM_BOT_TOKEN=

# Development / QA bot token (@StixMagicdevBot or similar).
# Required when APP_ENV=development. There is NO fallback to TELEGRAM_BOT_TOKEN.
DEV_BOT_TOKEN=

# ── API & Session ─────────────────────────────────────────────────────────────
# Auto-generated or manually set API key for the REST API.
STIXMAGIC_API_KEY=

# Flask session signing secret.
SESSION_SECRET=

# ── Mini App ──────────────────────────────────────────────────────────────────
# Full URL of the Telegram Mini App (optional).
# Auto-detected from REPLIT_DOMAINS if not set.
MINIAPP_URL=

# Replit public domain(s) for CORS allow-list (comma-separated, optional).
REPLIT_DOMAINS=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Comma-separated list of Telegram user IDs allowed to run /env and other
# admin-only commands.
#
# Behavior is environment-dependent:
#   • development, empty → any user may run admin commands (QA convenience).
#   • development, set   → only those IDs may run admin commands.
#   • production,  empty → /env is disabled for everyone (fail-closed).
#   • production,  set   → only those IDs may run admin commands.
#
# ⚠ Always set ADMIN_USER_IDS in production.
ADMIN_USER_IDS=

# ── Expected Bot Identity (optional, recommended for production) ───────────────
# Numeric bot IDs used for deterministic startup safety.  When set,
# validate_config() rejects the token if its bot ID doesn't match — even if
# the opposite-environment token is absent.
# Example: EXPECTED_PROD_BOT_ID=123456789
EXPECTED_PROD_BOT_ID=
EXPECTED_DEV_BOT_ID=

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Override individual feature flags. Values: true | false | 1 | 0
# Defaults: dev_banner=true in development, false in production.
#           animated_loaders=false in all environments.
# FEATURE_DEV_BANNER=true
# FEATURE_ANIMATED_LOADERS=false
