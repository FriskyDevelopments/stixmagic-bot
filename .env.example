# Stix Magic Bot — environment variable template
# Copy this file to .env for local development.
# Do not commit real secret values.

# Runtime mode: development | production | test
APP_ENV=development

# Required bot token variables.
# Preferred naming uses environment-specific variables.
BOT_TOKEN_DEV=
BOT_TOKEN_PROD=

# Required API key variables for the Flask API.
STIXMAGIC_API_KEY_DEV=
STIXMAGIC_API_KEY_PROD=

# Recommended session secrets.
SESSION_SECRET_DEV=
SESSION_SECRET_PROD=

# Optional Mini App URLs.
MINIAPP_URL_DEV=
MINIAPP_URL_PROD=

# Legacy compatibility aliases still supported by the app:
# TELEGRAM_BOT_TOKEN=
# STIXMAGIC_API_KEY=
# SESSION_SECRET=
# MINIAPP_URL=

# Optional port override for the bundled Flask API.
PORT=5000
