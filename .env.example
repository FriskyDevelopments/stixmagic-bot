# STIX MΛGIC shared environment template
# Copy to .env for local development.

# Required for bot runtime + Mini App auth validation.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Recommended canonical bot username, without @.
TELEGRAM_BOT_USERNAME=stixmagicbot

# Required for authenticated admin API routes.
STIXMAGIC_API_KEY=your_api_key_here

# Recommended in production: canonical public origin for landing/API/Mini App.
STIXMAGIC_PUBLIC_BASE_URL=https://your-app.example.com

# Shared persistence path used by both bot and API.
STIXMAGIC_DB_PATH=bot.db

# Explicit bot runtime mode. Only polling is implemented today.
TELEGRAM_BOT_MODE=polling

# Reserved for future webhook deployment support.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Legacy override if you need to pin a non-standard Mini App URL.
# MINIAPP_URL=https://your-app.example.com/miniapp
